  "headings": [
    {
      "tag": "h2",
      "text": "TIDE IN SPACE"
    },
    {
      "tag": "h2",
      "text": "Tide signs Space Act Agreementwith NASA"
    },
    {
      "tag": "h2",
      "text": "Continuing our commitment to Earth"
    },
    {
      "tag": "h2",
      "text": "The Future of Clean"
    },
    {
      "tag": "h2",
      "text": "Giving astronauts clean clothes more often"
    },
